{
  "name": "creator-voice-agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "doctor": "node scripts/doctor.mjs",
    "auth:create-user": "node scripts/auth-create-user.mjs",
    "vapi:connect": "node scripts/vapi-connect.mjs",
    "vapi:tunnel": "bash scripts/vapi-tunnel.sh",
    "vapi:check": "node scripts/vapi-check.mjs",
    "deploy": "npm run build && bash scripts/sites-env.sh -- wrangler deploy",
    "deploy:check": "bash scripts/preflight-deploy.sh",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "db:migrate": "bash scripts/sites-env.sh -- wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "bash scripts/sites-env.sh -- wrangler d1 migrations apply DB --remote",
    "typecheck": "bash scripts/sites-env.sh -- tsc --noEmit --incremental false",
    "types:cf": "bash scripts/sites-env.sh -- wrangler types --include-env false worker-configuration.d.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Creator Voice Agent"
}
