APP_NAME=FinSight AI
APP_ENV=development
DATABASE_URL=sqlite:///./runtime/finsight.db
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=120
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MAX_UPLOAD_MB=20
RATE_LIMIT_PER_MINUTE=180
DEMO_EMAIL=demo@finsight.ai
DEMO_PASSWORD=DemoPass123!

# Retrieval / GraphRAG
RETRIEVAL_MODE=hybrid
EMBEDDING_BACKEND=local_hashing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RERANKER_BACKEND=feature
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
DENSE_WEIGHT=0.42
BM25_WEIGHT=0.33
RERANK_WEIGHT=0.20
GRAPH_WEIGHT=0.05
RETRIEVAL_CANDIDATE_K=40

# Grounded generation: extractive | ollama | chat_completions
GENERATOR_BACKEND=extractive
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=llama3.2:3b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45
ENFORCE_CITATIONS=true
PROMPT_INJECTION_GUARD=true

# Optional production integrations
REDIS_URL=
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_REGION=us-east-1
SEC_USER_AGENT=FinSightAI your-email@example.com
FINBERT_ENABLED=false
FINBERT_MODEL=ProsusAI/finbert
OCR_ENABLED=false
NEWS_API_URL=
NEWS_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Report / background job configuration
REPORT_OUTPUT_DIR=./runtime/reports
BACKGROUND_JOBS_BACKEND=inline
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
